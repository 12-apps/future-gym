{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "scripts/ci/**",
    ".ci/**",
    ".github/workflows/ci.yml"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH",
    "EXPO_UNSTABLE_TREE_SHAKING"
  ]
}
