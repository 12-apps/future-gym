{
  "extends": [
    "@12-apps/typescript-config/react-library.json",
    "expo/tsconfig.base"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "customConditions": [
      "react-native"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.tsx",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    ".expo",
    "dist"
  ]
}
