{
  "name": "future-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "test:ci": "node scripts/ci/run-mobile-tests.mjs",
    "test:ci:full": "node scripts/ci/run-mobile-tests.mjs",
    "dev:mobile": "pnpm --filter @repo/mobile dev"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "1.22.0",
    "@12-apps/typescript-config": "1.21.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  }
}
